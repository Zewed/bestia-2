{
  "name": "bestia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run check:code && npm run secrets",
    "db:check": "tsx scripts/db-check.ts",
    "secrets": "tsx scripts/check-secrets.ts",
    "secrets:history": "tsx scripts/check-secrets.ts --history",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:guard": "tsx scripts/check-migrations.ts",
    "db:dev-setup": "tsx scripts/db-dev-setup.ts",
    "test": "vitest run",
    "check:code": "npm run lint && npm run typecheck && npm run db:guard && npm run test",
